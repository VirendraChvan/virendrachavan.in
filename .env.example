# Resend API Key (Recommended for Render free tier — sends via HTTPS Port 443)
# Get a free key at https://resend.com
RESEND_API_KEY=re_your_api_key_here
# Optional custom sender once domain is verified (defaults to Portfolio Contact <onboarding@resend.dev>):
# RESEND_FROM=Portfolio Contact <onboarding@resend.dev>

# Fallback SMTP settings (requires open outbound port 587; blocked on Render Free Tier):

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
DEST_EMAIL=chavanvirendra11@gmail.com

# NOTE: RENDER_EXTERNAL_URL is injected automatically by Render on deployment.
# Do NOT set this manually in .env — it is only used by the keep-alive self-ping task.
# RENDER_EXTERNAL_URL=https://your-service.onrender.com
